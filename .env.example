# VibeBook ผ่าน Docker Compose (template) — copy เป็น .env ที่ root ของ repo แล้วกรอก key · ห้าม commit .env
# คู่มือเต็ม: docs/DEPLOY.md

# ── AI (ต้องมีอย่างน้อยหนึ่งเจ้า) ─────────────────────────
# openrouter | meta
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta/muse-spark-1.3
# ขั้นเขียน HTML ของแอป — ว่างไว้ = ใช้ CHAT_MODEL
OPENROUTER_CODE_MODEL=

# ใช้เมื่อ AI_PROVIDER=meta (key ที่ docs ของ Meta เรียกว่า MODEL_API_KEY)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3-contributor
META_CODE_MODEL=

# ── ที่อยู่ของเว็บ ───────────────────────────────────────
# URL ที่คนอื่นเปิดเว็บได้ ใช้ทำลิงก์แชร์ /p/… และการ์ดพรีวิวลิงก์ (ไม่มี / ปิดท้าย)
#   บนเครื่องตัวเอง: http://localhost:3000
#   บน server ที่มีโดเมน (profile https): https://<DOMAIN>
APP_URL=http://localhost:3000
# โดเมนที่ชี้ A record มาที่ server นี้ ใช้กับ `docker compose --profile https up -d`
DOMAIN=

# พอร์ตของเว็บบนเครื่อง host — ค่าเริ่มต้นเปิดให้เฉพาะเครื่องนี้ (127.0.0.1)
# ถ้าจะให้เครื่องอื่นในวงแลนเปิดผ่าน http ตรง ๆ ให้ตั้ง WEB_BIND=0.0.0.0
WEB_PORT=3000
WEB_BIND=127.0.0.1

# ── Storage ──────────────────────────────────────────────
# ปล่อยว่าง = ใช้ Redis ที่มากับ compose (ข้อมูลอยู่ใน volume redis-data)
# ถ้าจะใช้ Upstash จริง ใส่ REST URL + token ของ database นั้นแทน
KV_REST_API_URL=
KV_REST_API_TOKEN=
# รหัสระหว่างเว็บกับ Redis ที่มากับ compose (ไม่ได้เปิดออกนอก Docker) — เปลี่ยนเป็นค่าสุ่มได้
REDIS_HTTP_TOKEN=vibebook-local
