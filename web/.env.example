# VibeBook server env (template) — copy เป็น .env.local แล้วกรอก key · ไฟล์นี้ commit ได้ ห้ามใส่ key จริง
# บน Vercel ต้องตั้งค่าชุดเดียวกันใน Project Settings → Environment Variables

# ── เลือก client ─────────────────────────────────────────
# chat (ดูรูป + เสนอไอเดีย + เขียน spec + สั่งแก้): openrouter | meta
AI_PROVIDER=openrouter
# สร้าง/แก้ภาพ (P1): openrouter | meta — ว่างไว้ = ใช้ตาม AI_PROVIDER
IMAGE_PROVIDER=

# ── OpenRouter ───────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# รุ่น -contributor ถูกกว่า 12–20 เท่า แต่ต้องเปิด "paid model training" ใน openrouter.ai/settings/privacy (Meta เอา input ไปเทรน)
OPENROUTER_CHAT_MODEL=meta/muse-spark-1.3
# ขั้นเขียน HTML ของ track แอป — ว่างไว้ = ใช้ CHAT_MODEL
OPENROUTER_CODE_MODEL=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# ── Meta Model API ───────────────────────────────────────
# key ที่ docs ของ Meta เรียกว่า MODEL_API_KEY
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3-contributor
# ว่างไว้ = ใช้ CHAT_MODEL
META_CODE_MODEL=
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1

# ── Storage (ได้จาก Vercel → Storage: Upstash Redis + Blob) ─
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# ── App ──────────────────────────────────────────────────
# บน Vercel ใส่ production URL (ใช้ทำลิงก์แชร์และการ์ด OG)
APP_URL=http://localhost:3000
